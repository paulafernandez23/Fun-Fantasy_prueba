rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para comprobar si el usuario es administrador vía Custom Claims
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Perfil de usuario: solo el propio usuario puede gestionar su perfil. Los admins pueden leerlos para gestión.
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.total > 0 
                    && request.resource.data.items.size() > 0
                    && request.resource.data.created_at != null;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.user_id);
      allow update, delete: if isAdmin();
    }

    match /appointments/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contact_messages/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /mail/{document=**} {
      allow create: if isAdmin(); // El sistema usa el Admin SDK, por lo que este 'false' no bloquea al backend.
      allow read, update, delete: if isAdmin();
    }

    match /newsletter/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /loyalty/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    match /app_settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /legal_pages/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contenido CMS de las páginas públicas
    match /site_content/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categorías de productos
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
